# =======================================================================
# Tier B — Versioned shared modules
# Browser caches forever; HTMLs reference these as foo.js?v=<bundle-hash>.
# When any Bucket B file changes, bundle hash regenerates, query string
# rotates, URL key changes, cache miss forces re-download.
# /shared/bundle-version.js exact rule below adds no-cache (concatenates;
# no-cache wins over immutable).
# =======================================================================
/shared/*.js
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/shared/*.css
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

