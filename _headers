# Tiered Cache — see docs/sistemas/cache-strategy.md and CLAUDE.md
# "Tiered Cache — SUPREME RULE #0" for full rationale.
#
# IMPORTANT — Cloudflare Pages behavior: rules are CONCATENATED, not
# overridden. A catch-all /* with no-store would prepend no-store to
# every other rule and override immutable (most restrictive wins per
# RFC 9111). So we DO NOT have /* fallback. Unmatched paths use CF
# Pages defaults (typically no caching for unclassified static files).
#
# Tier semantics:
#   A (Frozen)    immutable max-age=1y    content NEVER changes per filename
#   B (Versioned) immutable max-age=1y    filename includes content-hash (?v=)
#   C (Live)      no-cache                revalidate every visit (HTML)
#   Manifest/SW   no-cache, must-revalidate
#
# When multiple rules match the same path, headers concatenate; most-
# restrictive directive wins. Examples:
#   /shared/bundle-version.js matches both /shared/*.js (immutable) AND
#   /shared/bundle-version.js (no-cache, must-revalidate). Concatenated:
#   "public, max-age=..., immutable, no-cache, must-revalidate".
#   Browser: no-cache wins → always revalidates. CORRECT.
#
# Service Worker (sw.js) remains PURE PASS-THROUGH — see CLAUDE.md.

# =======================================================================
# Tier A — Frozen assets (content per filename never changes)
# These files are append-only: new files added, existing files never mutated.
# =======================================================================

# Audio library (~849MB across ~291 tracks; filename = canonical identity)
/shared/audio/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Font files (woff2; @font-face URLs are stable)
/shared/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Shared images (logo, valdorita coin)
/shared/img/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Character creator race portraits (9 PNGs ~3.77MB total)
/character_creator/races/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Apoie landing page parallax layers
/apoie/layers/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Favicons / brand assets
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/favicon.ico
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# =======================================================================
# Tier B — Versioned shared modules
# Browser caches forever; HTMLs reference these as foo.js?v=<bundle-hash>.
# When any Bucket B file changes, bundle hash regenerates, query string
# rotates, URL key changes, cache miss forces re-download.
# /shared/bundle-version.js exact rule below adds no-cache (concatenates;
# no-cache wins over immutable).
# =======================================================================
/shared/*.js
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/shared/*.css
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Per-zone shared data modules
/cidade/cartografia-shared.js
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/combat2/combate-data-shared.js
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/exploracao/cartografia-shared.js
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/exploracao/tile_events_data.js
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/exploracao/exploracao_events_data.js
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Global design system tokens (Tier B — versioned via bundle hash)
/valdoria-design.css
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Bundle hash script — MUST revalidate on every visit so a deploy that
# bumps the hash reaches every player immediately. Lives at root path
# (NOT inside /shared/ + no underscore prefix) so neither the
# /shared/*.js wildcard nor CF Pages reserved-path handling apply.
# Uses bare `no-cache` (same syntax as /cidade/ which works), without
# `must-revalidate` — CF Pages was honoring nosniff but ignoring our
# Cache-Control when both were combined with must-revalidate.
/bundle-version.js
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

# =======================================================================
# Tier C — HTML gameplay entry points (revalidate every visit via ETag/304)
# CF Pages auto-generates ETag from content hash. Unchanged HTML returns
# 304 (~200B headers only) instead of full body — ~99% bandwidth savings
# on revisits without ever serving stale code.
# =======================================================================

# Explicit HTML suffix
/*.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

# Root and directory entry points (CF Pages serves /<dir>/ → /<dir>/index.html;
# URL pattern is /<dir>/, so we add specific rules for each gameplay dir)
