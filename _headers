  X-Content-Type-Options: nosniff

# Bundle hash script — MUST revalidate on every visit so a deploy que
# bumps the hash reaches every player immediately. Lives at root path
# (NOT inside /shared/ + no underscore prefix) so neither the
# /shared/*.js wildcard nor CF Pages reserved-path handling apply.
# Sessao #37 (2026-05-25): CF Pages estava servindo max-age=14400
# apesar de `Cache-Control: no-cache` aqui. Investigacao confirmou
# `cf-cache-status: REVALIDATED` mas browser recebia max-age=14400.
# Workaround: explicit max-age=0 + no-store pra force browser sempre
# revalidar. Combinado com bundle hash bumping garante deploys imediatos.
/bundle-version.js
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Pragma: no-cache

# =======================================================================
# Tier C — HTML gameplay entry points (revalidate every visit via ETag/304)
# CF Pages auto-generates ETag from content hash. Unchanged HTML returns
# 304 (~200B headers only) instead of full body — ~99% bandwidth savings
# on revisits without ever serving stale code.
# =======================================================================

# Explicit HTML suffix
/*.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

# Root and directory entry points (CF Pages serves /<dir>/ → /<dir>/index.html;
# URL pattern is /<dir>/, so we add specific rules for each gameplay dir)
/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

# Sessão #63 (2026-05-28) BUG-3 mitigation: Referrer-Policy: no-referrer.
# Mitigação prática pra "tokens em URL query string". Tokens das WebApps
# (cidade/combat2/exploracao/levelup) aparecem como ?token=XXX na URL —
# refactor completo pra /play/ entry point é multi-sessão (BUG-3 backlog).
# Mitigação imediata: no-referrer impede que browser envie Referer header
# (contendo token) ao carregar sub-recursos externos (imagens CDN, fonts,
# beacons analytics). Sem isso, qualquer recurso externo carregado pela
# página recebia o token no Referer. Combinado com TTL 30min e Cloudflare
# logs admin-only, reduz dramaticamente a janela de exposição.
# Spec: https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Referrer-Policy
/play/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

