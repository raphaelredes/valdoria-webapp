# Tiered Cache — see docs/sistemas/cache-strategy.md and CLAUDE.md
# "Tiered Cache — SUPREME RULE #0" for full rationale.
#
# Tier semantics (Cloudflare Pages reads bottom-up; more-specific paths win):
#   A (Frozen)    immutable max-age=1y    content NEVER changes per filename
#   B (Versioned) immutable max-age=1y    filename includes content-hash (Fase 2)
#   C (Live)      no-cache  + ETag/304    revalidate every visit (HTML gameplay)
#   API/JSON      no-store                bot/server responses (in Python, not here)
#   Fallback      no-store                belt-and-suspenders default
#
# Service Worker (sw.js) remains PURE PASS-THROUGH — see CLAUDE.md.
# Browser HTTP cache is the only caching layer enabled.

# =======================================================================
# Catch-all fallback (Tier C default + safety net for unclassified paths)
# =======================================================================
/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff

# =======================================================================
# Tier A — Frozen assets (content per filename never changes)
# These files are append-only: new files added, existing files never mutated.
# =======================================================================

# Audio library (~849MB across ~291 tracks; filename = canonical identity)
/shared/audio/*
  Cache-Control: public, max-age=31536000, immutable

# Font files (woff2; @font-face URLs are stable)
/shared/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Shared images (logo, valdorita coin)
/shared/img/*
  Cache-Control: public, max-age=31536000, immutable

# Character creator race portraits (9 PNGs ~3.77MB total)
/character_creator/races/*
  Cache-Control: public, max-age=31536000, immutable

# Apoie landing page parallax layers
/apoie/layers/*
  Cache-Control: public, max-age=31536000, immutable

# Vendored Three.js library (no in-tree edits; updates land as a new file)
/shared/three.min.js
  Cache-Control: public, max-age=31536000, immutable

# Favicons / brand assets
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

# =======================================================================
# Tier B — Versioned shared modules
# Browser caches forever; HTMLs reference these as foo.js?v=<bundle-hash>.
# When any Bucket B file changes, the bundle hash regenerates, query string
# rotates, URL key changes, cache miss forces re-download. Coarse but safe.
# Generated by scripts/build_manifest.py — exact list in BUCKET_B_PATHS.
# More-specific rules below override these for the bundle-hash script
# itself (must always be fresh).
# =======================================================================
/shared/*.js
  Cache-Control: public, max-age=31536000, immutable

/shared/*.css
  Cache-Control: public, max-age=31536000, immutable

# Per-zone shared data modules (large data files, also in Bucket B)
/cidade/cartografia-shared.js
  Cache-Control: public, max-age=31536000, immutable

/combat2/combate-data-shared.js
  Cache-Control: public, max-age=31536000, immutable

/exploracao/cartografia-shared.js
  Cache-Control: public, max-age=31536000, immutable

/exploracao/tile_events_data.js
  Cache-Control: public, max-age=31536000, immutable

/exploracao/exploracao_events_data.js
  Cache-Control: public, max-age=31536000, immutable

# Global design system tokens
/valdoria-design.css
  Cache-Control: public, max-age=31536000, immutable

# Bundle hash script — MUST always revalidate so a deploy that bumps the
# hash reaches every player on next visit (cheap 304 if unchanged).
# Exact path overrides /shared/*.js wildcard above.
/shared/_bundle-hash.js
  Cache-Control: no-cache, must-revalidate
  X-Content-Type-Options: nosniff

# =======================================================================
# Tier C — HTML gameplay entry points (revalidate every visit via ETag/304)
# CF Pages auto-generates ETag from content hash. Unchanged HTML returns
# 304 (~200B headers only) instead of full body — ~99% bandwidth savings
# on revisits without ever serving stale code.
# =======================================================================
/*.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

# Service Worker, manifest, and asset manifest must never sit in browser cache
# (need fresh fetch on every load so updates propagate)
/sw.js
  Cache-Control: no-cache, must-revalidate
  X-Content-Type-Options: nosniff

/manifest.json
  Cache-Control: no-cache, must-revalidate
  X-Content-Type-Options: nosniff

/asset-manifest.json
  Cache-Control: no-cache, must-revalidate
  X-Content-Type-Options: nosniff
