  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/play/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/cidade/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/combat2/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/exploracao/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/character_creator/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/levelup/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/prologue/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/web/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/pix/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/dice/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/apoie/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/legal/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

# Service Worker, manifest, and asset manifest must never sit in browser cache
# (need fresh fetch on every load so updates propagate)
/sw.js
  Cache-Control: no-cache, must-revalidate
  X-Content-Type-Options: nosniff

/manifest.json
  Cache-Control: no-cache, must-revalidate
  X-Content-Type-Options: nosniff

/asset-manifest.json
  Cache-Control: no-cache, must-revalidate
  X-Content-Type-Options: nosniff
