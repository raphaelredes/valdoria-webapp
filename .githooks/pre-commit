#!/bin/bash
# Pre-commit hook: ESLint on staged JS files (errors only — warnings allowed)
# Install: git config core.hooksPath .githooks

JS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.js$' | grep -v 'three.min.js' | grep -v 'node_modules' | grep -v 'scripts/' | grep -v 'mockups/')
if [ -z "$JS_FILES" ]; then exit 0; fi

# ESLint — block on errors, allow warnings
if command -v npx &>/dev/null && [ -f "eslint.config.js" ]; then
    npx eslint --no-warn-ignored --quiet $JS_FILES 2>&1
    if [ $? -ne 0 ]; then
        echo ""
        echo "Commit blocked: ESLint found errors in staged JS files."
        echo "Fix the errors above and try again."
        echo "Run: npx eslint --fix <file> to auto-fix some issues."
        exit 1
    fi
else
    # Fallback: basic node -c syntax check
    for f in $JS_FILES; do
        if [ ! -f "$f" ]; then continue; fi
        result=$(node -c "$f" 2>&1)
        if [ $? -ne 0 ]; then
            echo "ERROR: JS syntax error in $f"
            echo "$result" | head -3
            exit 1
        fi
    done
fi
exit 0
